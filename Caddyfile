# DeepResearch 反向代理（Caddy 2，自动申请并续期 HTTPS 证书）
#
# 用法：
#   DR_DOMAIN=your.domain docker compose --profile proxy up -d
# 未设 DR_DOMAIN 时回落到 localhost（仅本地 HTTP 调试，不会走 ACME）。
# 无域名场景（公网 IP 直访）：
#   DR_DOMAIN=https://<公网IP> 且 DR_DEFAULT_SNI=<公网IP>
#   —— 浏览器直访 IP 不发送 SNI，需要 default_sni 回退才能选到证书；
#   —— 使用 Caddy 内部 CA 签发，客户端需信任根证书（或点击浏览器警告继续）。
#   —— 提醒：大陆服务器上未备案域名会被云厂商在 80（webblock）与 443（SNI reset）拦截，
#      域名模式必须先完成 ICP 备案。
#
# 验收口径见 docs/operations/production-readiness.md §7.1（SSE 必须穿透、心跳 15s 不断）。
# 上线前请真机验证一次：浏览器跑完一个完整任务，确认进度条持续推进不中断。

{
	# 客户端未发送 SNI 时（浏览器直访 IP 属此类）用于证书选择的回退名。
	# 默认 localhost 仅为本地调试；公网 IP 直访场景在 .env 设 DR_DEFAULT_SNI=<公网IP>。
	default_sni {$DR_DEFAULT_SNI:localhost}
}

{$DR_DOMAIN} {
	# ---- SSE 事件流：不压缩、不缓冲 ----
	# 压缩会让代理缓冲响应体，表现为「进度条长时间不动然后一次性跳完」；
	# flush_interval -1 是 Caddy 的「收到即转发」开关。
	@stream path /api/research/*/stream
	handle @stream {
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				# 单次运行默认超时 3600s（DR_RUN_TIMEOUT_SECONDS），留 5 分钟余量
				read_timeout 3900s
				write_timeout 3900s
			}
		}
	}

	# ---- 其余路径：正常压缩 ----
	handle {
		encode zstd gzip
		reverse_proxy api:8000
	}

	# 上传上限对齐 DR_RAG_MAX_FILE_MB（默认 10 MB）+ multipart 余量；
	# 超过直接在代理层拒绝，不打到应用层。
	request_body {
		max_size 12MB
	}

	log {
		output stdout
		format console
	}
}
