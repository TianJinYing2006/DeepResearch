<Slide style={{ width: '1280px', height: '720px', padding: 0, background: '#FFFFFF', position: 'relative', overflow: 'hidden' }}>

    {/* 顶部渐变装饰条（≤8px，全篇仅封面/结束页使用） */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: '1280px', height: '8px', background: 'linear-gradient(135deg, #0E3F8C 0%, #1E4FA8 100%)' }} />

    <Box style={{ flexDirection: 'row', width: '1280px', height: '720px' }}>

        {/* 左：文字骑入区（占 55%） */}
        <Box style={{ width: '700px', height: '720px', padding: '72px 48px 72px 64px', justifyContent: 'center', gap: 18 }}>

            <Box style={{ flexDirection: 'row' }}>
                <Box style={{ padding: '6px 16px', background: '#E8EFF8', borderRadius: 12 }}>
                    <Text style={{ fontSize: 15, color: '#0E3F8C', fontWeight: 'bold' }}>课程项目汇报 · 2026 年 10 月</Text>
                </Box>
            </Box>

            <Text style={{ fontSize: 64, fontWeight: 'bold', color: '#0E3F8C', lineHeight: 1.15, letterSpacing: 1 }}>
                DeepResearch
            </Text>

            <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#1A2230', lineHeight: 1.3 }}>
                深度研究 Agent
            </Text>

            <Text style={{ fontSize: 21, color: '#4A5568', lineHeight: 1.6 }}>
                把「继续检索还是收尾」的决策<br />写进图结构，而不是写进提示词
            </Text>

            <Box style={{ width: '120px', height: '2px', background: '#D6DCE5', marginTop: 6 }} />

            <Box style={{ gap: 8, marginTop: 6 }}>
                <Text style={{ fontSize: 17, color: '#4A5568' }}>· LangGraph 多 Agent 编排，8 节点状态机</Text>
                <Text style={{ fontSize: 17, color: '#4A5568' }}>· 网络 / arXiv / 私有知识库三路证据融合</Text>
                <Text style={{ fontSize: 17, color: '#4A5568' }}>· 引用可回溯，故障可归因</Text>
            </Box>

            <Box style={{ marginTop: 10, gap: 4 }}>
                <Text style={{ fontSize: 16, color: '#1A2230', fontWeight: 'bold' }}>汇报人：田金应</Text>
                <Text style={{ fontSize: 15, color: '#8B97A8' }}>安徽工业大学 · 计算机科学与技术</Text>
            </Box>
        </Box>

        {/* 右：L1 主视觉 —— 抽象编排线稿（占 45%） */}
        <Box style={{ width: '580px', height: '720px', background: '#F0F5FC', alignItems: 'center', justifyContent: 'center' }}>
            <svg width={460} height={520} viewBox='0 0 480 520'>
                {/* 连接线（主链） */}
                <path d='M240 46 L240 86' fill='none' stroke='#3D7BD9' strokeWidth='2' />
                <path d='M240 124 L240 164' fill='none' stroke='#3D7BD9' strokeWidth='2' />
                <path d='M240 202 L240 222 L80 222 L80 248' fill='none' stroke='#3D7BD9' strokeWidth='2' />
                <path d='M240 202 L240 222 L400 222 L400 248' fill='none' stroke='#3D7BD9' strokeWidth='2' />
                <path d='M400 286 L400 326' fill='none' stroke='#3D7BD9' strokeWidth='2' />
                <path d='M400 364 L400 404' fill='none' stroke='#3D7BD9' strokeWidth='2' />
                <path d='M400 442 L400 468' fill='none' stroke='#3D7BD9' strokeWidth='2' />
                <path d='M150 105 L180 105' fill='none' stroke='#3D7BD9' strokeWidth='2' />
                <path d='M150 88 L150 122' fill='none' stroke='#3D7BD9' strokeWidth='2' />

                {/* 两条回环（虚线红） */}
                <path d='M24 267 L10 267 L10 105 L180 105' fill='none' stroke='#D9534F' strokeWidth='2' strokeDasharray='6 4' />
                <path d='M456 423 L470 423 L470 345 L456 345' fill='none' stroke='#D9534F' strokeWidth='2' strokeDasharray='6 4' />

                {/* 检索源标记 */}
                <circle cx='150' cy='88' r='7' fill='#3D7BD9' />
                <circle cx='150' cy='105' r='7' fill='#1E4FA8' />
                <circle cx='150' cy='122' r='7' fill='#3D7BD9' />

                {/* 主链节点 */}
                <rect x='180' y='8' width='120' height='38' rx='8' fill='#0E3F8C' />
                <text x='240' y='33' fontSize='15' fill='#FFFFFF' textAnchor='middle' fontWeight='bold'>plan</text>

                <rect x='180' y='86' width='120' height='38' rx='8' fill='#0E3F8C' />
                <text x='240' y='111' fontSize='15' fill='#FFFFFF' textAnchor='middle' fontWeight='bold'>research</text>

                <rect x='180' y='164' width='120' height='38' rx='8' fill='#0E3F8C' />
                <text x='240' y='189' fontSize='15' fill='#FFFFFF' textAnchor='middle' fontWeight='bold'>critic</text>

                {/* 分支节点 */}
                <rect x='24' y='248' width='112' height='38' rx='8' fill='#FFFFFF' stroke='#3D7BD9' strokeWidth='2' />
                <text x='80' y='273' fontSize='15' fill='#1A2230' textAnchor='middle' fontWeight='bold'>revise</text>

                <rect x='344' y='248' width='112' height='38' rx='8' fill='#FFFFFF' stroke='#3D7BD9' strokeWidth='2' />
                <text x='400' y='273' fontSize='15' fill='#1A2230' textAnchor='middle' fontWeight='bold'>write</text>

                <rect x='344' y='326' width='112' height='38' rx='8' fill='#1E4FA8' />
                <text x='400' y='351' fontSize='15' fill='#FFFFFF' textAnchor='middle' fontWeight='bold'>validate</text>

                <rect x='344' y='404' width='112' height='38' rx='8' fill='#FFFFFF' stroke='#3D7BD9' strokeWidth='2' />
                <text x='400' y='429' fontSize='15' fill='#1A2230' textAnchor='middle' fontWeight='bold'>repair</text>

                <rect x='344' y='468' width='112' height='38' rx='8' fill='#0E3F8C' />
                <text x='400' y='493' fontSize='15' fill='#FFFFFF' textAnchor='middle' fontWeight='bold'>render</text>

                {/* 图例 */}
                <text x='240' y='514' fontSize='13' fill='#8B97A8' textAnchor='middle'>实线 = 主链　虚线 = 回环</text>
            </svg>
        </Box>
    </Box>
</Slide>
