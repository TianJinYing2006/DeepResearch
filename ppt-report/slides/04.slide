<Slide style={{ width: '1280px', height: '720px', padding: '24px 40px', background: '#FFFFFF' }}>

    {/* A · 页眉顶条 */}
    <Box style={{ height: '48px', background: '#0E3F8C', borderRadius: 6, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 24px' }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 'bold' }}>DeepResearch · 深度研究 Agent</Text>
        <Text style={{ fontSize: 16, color: '#FFFFFF', opacity: 0.85 }}>01 项目背景与目标</Text>
    </Box>

    <Box style={{ height: '12px' }} />

    {/* B · 标题块 */}
    <Box style={{ height: '72px', justifyContent: 'center', gap: 4 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1A2230' }}>为什么需要「深度研究」，而不是一次问答</Text>
        <Text style={{ fontSize: 16, color: '#4A5568' }}>三个缺口都指向同一件事：研究是带终止条件的循环，不是一次调用</Text>
    </Box>

    <Box style={{ height: '12px' }} />

    {/* C · 内容区：非对称双栏 64:36 */}
    <Box style={{ height: '484px', gap: 12 }}>
        <Box style={{ flex: 1, flexDirection: 'row', gap: 20 }}>

            {/* 左 · 三个缺口 */}
            <Box style={{ width: '752px', gap: 10 }}>
                <Box style={{ height: '80px', background: '#F7F9FC', borderRadius: 8, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-around', padding: '0 20px' }}>
                    <Box style={{ alignItems: 'center', gap: 4 }}>
                        <Text style={{ fontSize: 15, color: '#8B97A8' }}>单次问答</Text>
                        <svg width={200} height={34} viewBox='0 0 200 34'>
                            <rect x='0' y='7' width='52' height='20' rx='6' fill='#FFFFFF' stroke='#8B97A8' strokeWidth='1.5' />
                            <text x='26' y='21' fontSize='12' fill='#8B97A8' textAnchor='middle'>Q</text>
                            <path d='M56 17 L96 17' fill='none' stroke='#8B97A8' strokeWidth='1.5' />
                            <rect x='100' y='7' width='52' height='20' rx='6' fill='#FFFFFF' stroke='#8B97A8' strokeWidth='1.5' />
                            <text x='126' y='21' fontSize='12' fill='#8B97A8' textAnchor='middle'>A</text>
                            <text x='164' y='21' fontSize='12' fill='#D9534F' textAnchor='middle'>够了？不知道</text>
                        </svg>
                    </Box>
                    <Box style={{ width: '1px', height: '48px', background: '#D6DCE5' }} />
                    <Box style={{ alignItems: 'center', gap: 4 }}>
                        <Text style={{ fontSize: 15, color: '#1E4FA8', fontWeight: 'bold' }}>研究循环</Text>
                        <svg width={260} height={34} viewBox='0 0 260 34'>
                            <rect x='0' y='7' width='46' height='20' rx='6' fill='#0E3F8C' />
                            <text x='23' y='21' fontSize='12' fill='#FFFFFF' textAnchor='middle'>Q</text>
                            <path d='M50 17 L74 17' fill='none' stroke='#3D7BD9' strokeWidth='2' />
                            <rect x='78' y='7' width='86' height='20' rx='6' fill='#1E4FA8' />
                            <text x='121' y='21' fontSize='12' fill='#FFFFFF' textAnchor='middle'>检索→裁决</text>
                            <path d='M168 27 L196 27 L196 17 L214 17' fill='none' stroke='#D9534F' strokeWidth='2' strokeDasharray='5 3' />
                            <path d='M168 17 L214 17' fill='none' stroke='#3D7BD9' strokeWidth='2' />
                            <rect x='218' y='7' width='42' height='20' rx='6' fill='#0E3F8C' />
                            <text x='239' y='21' fontSize='12' fill='#FFFFFF' textAnchor='middle'>报告</text>
                        </svg>
                    </Box>
                </Box>

                <Box style={{ flex: 1, flexDirection: 'row', gap: 14, padding: '14px 20px', background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 8, alignItems: 'center' }}>
                    <Box style={{ width: '34px', height: '34px', background: '#E8EFF8', borderRadius: 8, alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C' }}>1</Text>
                    </Box>
                    <Box style={{ flex: 1, gap: 2 }}>
                        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1A2230' }}>没有「信息充分度」这个概念</Text>
                        <Text style={{ fontSize: 16, color: '#4A5568' }}>一次检索不够也只能硬写，缺的部分由模型自行补全 → 幻觉温床</Text>
                    </Box>
                </Box>

                <Box style={{ flex: 1, flexDirection: 'row', gap: 14, padding: '14px 20px', background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 8, alignItems: 'center' }}>
                    <Box style={{ width: '34px', height: '34px', background: '#E8EFF8', borderRadius: 8, alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C' }}>2</Text>
                    </Box>
                    <Box style={{ flex: 1, gap: 2 }}>
                        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1A2230' }}>检索深度靠感觉，没有显式预算</Text>
                        <Text style={{ fontSize: 16, color: '#4A5568' }}>该停在哪一层、还能花多少跳，全凭运气；跑崩或跑飞都没人拦</Text>
                    </Box>
                </Box>

                <Box style={{ flex: 1, flexDirection: 'row', gap: 14, padding: '14px 20px', background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 8, alignItems: 'center' }}>
                    <Box style={{ width: '34px', height: '34px', background: '#E8EFF8', borderRadius: 8, alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C' }}>3</Text>
                    </Box>
                    <Box style={{ flex: 1, gap: 2 }}>
                        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1A2230' }}>生成完就交付，引用没人复核</Text>
                        <Text style={{ fontSize: 16, color: '#4A5568' }}>引用是否真实存在、论断是否有独立来源支撑，主流程里没有校验环节</Text>
                    </Box>
                </Box>
            </Box>

            {/* 右 · 对应应答 */}
            <Box style={{ width: '428px', background: '#F0F5FC', borderRadius: 8, padding: '20px 22px', gap: 12 }}>
                <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C' }}>本项目的应答</Text>
                <Box style={{ flex: 1, gap: 4 }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1A2230' }}>critic 节点裁决充分度</Text>
                    <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.5 }}>未达标就回填查询继续检索，达标才进入写作；充分度是图里的状态，不是提示词里的形容词</Text>
                </Box>
                <Box style={{ height: '1px', background: '#D6DCE5' }} />
                <Box style={{ flex: 1, gap: 4 }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1A2230' }}>显式跳数预算 + 确定性硬闸</Text>
                    <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.5 }}>全局 20 跳按子问题数动态切分；depth / token 二维硬闸先于 LLM 裁决生效</Text>
                </Box>
                <Box style={{ height: '1px', background: '#D6DCE5' }} />
                <Box style={{ flex: 1, gap: 4 }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1A2230' }}>validate 进入图内做双层校验</Text>
                    <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.5 }}>引用存在性 + 忠实度，不通过论断进附录而非删除，读者看得见才知道为何不可信</Text>
                </Box>
            </Box>
        </Box>

        {/* 底部结论条 */}
        <Box style={{ height: '56px', background: '#F0F5FC', borderRadius: 8, flexDirection: 'row', alignItems: 'center', padding: '0 22px', gap: 14 }}>
            <Box style={{ width: '4px', height: '32px', background: '#1E4FA8' }} />
            <Text style={{ fontSize: 18, color: '#1A2230' }}>所以本项目没有把研究写成一条长提示词，而是建成一张<span style={{ fontWeight: 'bold', color: '#0E3F8C' }}>带终止条件与回环的图</span>。</Text>
        </Box>
    </Box>

    <Box style={{ height: '12px' }} />

    {/* D · 页脚 */}
    <Box style={{ height: '32px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>DeepResearch 项目汇报 · 2026-10</Text>
        <Text style={{ fontSize: 14, color: '#1E4FA8' }}>04 / 23</Text>
    </Box>
</Slide>
