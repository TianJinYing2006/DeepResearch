<Slide style={{ width: '1280px', height: '720px', padding: '24px 40px', background: '#FFFFFF' }}>

    {/* A · 页眉顶条 */}
    <Box style={{ height: '48px', background: '#0E3F8C', borderRadius: 6, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 24px' }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 'bold' }}>DeepResearch · 深度研究 Agent</Text>
        <Text style={{ fontSize: 16, color: '#FFFFFF', opacity: 0.85 }}>05 工程落地与总结</Text>
    </Box>

    <Box style={{ height: '12px' }} />

    {/* B · 标题块 */}
    <Box style={{ height: '72px', justifyContent: 'center', gap: 4 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1A2230' }}>工作台首页：发起研究之前</Text>
        <Text style={{ fontSize: 16, color: '#4A5568' }}>五步流程条 + 阶段进度面板 + 知识库入口，一屏交代「研究会长什么样」</Text>
    </Box>

    <Box style={{ height: '12px' }} />

    {/* C · 内容区：左大图（首页截图）+ 右侧要点 */}
    <Box style={{ height: '484px', flexDirection: 'row', gap: 20 }}>

        {/* 左 · 首页截图 */}
        <Box style={{ width: '696px', gap: 8 }}>
            <Image
                src='assets/ui-01-home.png'
                style={{ width: 696, height: 435, objectFit: 'cover', borderRadius: 8, border: '1px solid #D6DCE5' }}
            />
            <Text style={{ fontSize: 14, color: '#8B97A8' }}>
                本地模式（未登录）下的工作台；鉴权开启后此处为登录门 + 邀请制
            </Text>
        </Box>

        {/* 右 · 要点 */}
        <Box style={{ width: '484px', gap: 10 }}>
            <Box style={{ gap: 5 }}>
                <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C' }}>流程先行</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.55 }}>
                    新研究 → 等待与进度 → 报告阅读 → 引用检查 → 导出与分享，五步条常驻顶部；阶段进度面板（规划 / 检索 / 撰写 / 校验 / 渲染）在提交前就已挂好。
                </Text>
            </Box>

            <Box style={{ height: '1px', background: '#D6DCE5' }} />

            <Box style={{ gap: 5 }}>
                <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C' }}>输入克制</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.55 }}>
                    只有两个输入框：研究主题 + 附加要求（时间范围 / 关注维度 / 报告风格）；运行档位由服务端固定并随 run 快照留痕，客户端改不了底层参数。
                </Text>
            </Box>

            <Box style={{ height: '1px', background: '#D6DCE5' }} />

            <Box style={{ gap: 5 }}>
                <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C' }}>知识库与历史</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.55 }}>
                    右侧是文档摄取状态与证据边栏提示；顶部入口：上传文档、知识库清单（当前 17 篇）、历史任务、帮助与反馈。
                </Text>
            </Box>

            <Box style={{ marginTop: 'auto', background: '#F0F5FC', borderRadius: 8, padding: '12px 16px' }}>
                <Text style={{ fontSize: 15, color: '#1A2230', lineHeight: 1.5 }}>
                    界面设计原则：<span style={{ fontWeight: 'bold', color: '#0E3F8C' }}>把「研究会长什么样」先告诉用户</span>，而不是黑盒转圈。
                </Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: '12px' }} />

    {/* D · 页脚 */}
    <Box style={{ height: '32px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>DeepResearch 项目汇报 · 2026-10</Text>
        <Text style={{ fontSize: 14, color: '#1E4FA8' }}>19 / 23</Text>
    </Box>
</Slide>
