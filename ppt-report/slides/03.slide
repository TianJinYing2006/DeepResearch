<Slide style={{ width: '1280px', height: '720px', padding: 0, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', position: 'relative', overflow: 'hidden' }}>

    {/* 左 · 章节数字 */}
    <Box style={{ width: '280px', height: '720px', alignItems: 'center', justifyContent: 'center', gap: 8 }}>
        <Text style={{ fontSize: 150, fontWeight: 'bold', color: '#F0F5FC', opacity: 0.3, lineHeight: 1.0 }}>01</Text>
        <Text style={{ fontSize: 14, color: '#FFFFFF', opacity: 0.6, letterSpacing: 3 }}>CHAPTER 01</Text>
    </Box>

    {/* 中 · 标题与要点 */}
    <Box style={{ width: '500px', height: '720px', justifyContent: 'center', gap: 18, paddingRight: 40 }}>
        <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.2 }}>项目背景与目标</Text>
        <Box style={{ width: '64px', height: '3px', background: '#FFFFFF', opacity: 0.5 }} />
        <Box style={{ gap: 12 }}>
            <Text style={{ fontSize: 17, color: '#FFFFFF', opacity: 0.9 }}>— 单次问答没有「信息充分度」概念</Text>
            <Text style={{ fontSize: 17, color: '#FFFFFF', opacity: 0.9 }}>— 检索深度靠感觉，没有显式预算</Text>
            <Text style={{ fontSize: 17, color: '#FFFFFF', opacity: 0.9 }}>— 引用生成完就交付，无人复核</Text>
            <Text style={{ fontSize: 17, color: '#FFFFFF', opacity: 0.9 }}>— 应答：critic 裁决 + 硬闸 + 图内校验</Text>
        </Box>
        <Box style={{ flexDirection: 'row' }}>
            <Box style={{ padding: '7px 14px', border: '1px solid rgba(255,255,255,0.4)', borderRadius: 14 }}>
                <Text style={{ fontSize: 14, color: '#FFFFFF', opacity: 0.85 }}>本章回答：为什么必须做成循环</Text>
            </Box>
        </Box>
    </Box>

    {/* 分隔线 */}
    <Box style={{ width: '1px', height: '440px', background: '#FFFFFF', opacity: 0.18 }} />

    {/* 右 · 界面实拍 */}
    <Box style={{ width: '420px', height: '720px', alignItems: 'center', justifyContent: 'center', gap: 12 }}>
        <Image
            src='assets/ui-07-mobile.png'
            style={{ width: 200, height: 430, objectFit: 'cover', borderRadius: 12, border: '2px solid rgba(255,255,255,0.35)' }}
        />
        <Text style={{ fontSize: 12, color: '#FFFFFF', opacity: 0.6 }}>界面实拍 · 窄屏自适应，无横向滚动</Text>
        <Box style={{ flexDirection: 'row', gap: 8 }}>
            <Box style={{ padding: '5px 12px', border: '1px solid rgba(255,255,255,0.4)', borderRadius: 12 }}>
                <Text style={{ fontSize: 13, color: '#FFFFFF', opacity: 0.9 }}>单次问答</Text>
            </Box>
            <Box style={{ padding: '5px 12px', border: '1px solid rgba(255,255,255,0.4)', borderRadius: 12 }}>
                <Text style={{ fontSize: 13, color: '#FFFFFF', opacity: 0.9 }}>研究循环</Text>
            </Box>
            <Box style={{ padding: '5px 12px', border: '1px solid rgba(255,255,255,0.4)', borderRadius: 12 }}>
                <Text style={{ fontSize: 13, color: '#FFFFFF', opacity: 0.9 }}>显式预算</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', bottom: 28, right: 56 }}>
        <Text style={{ fontSize: 14, color: '#FFFFFF', opacity: 0.6 }}>03 / 23</Text>
    </Box>
</Slide>
