<Slide style={{ width: '1280px', height: '720px', padding: '24px 40px', background: '#FFFFFF' }}>

    {/* A · 页眉顶条 */}
    <Box style={{ height: '48px', background: '#0E3F8C', borderRadius: 6, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 24px' }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 'bold' }}>DeepResearch · 深度研究 Agent</Text>
        <Text style={{ fontSize: 16, color: '#FFFFFF', opacity: 0.85 }}>05 工程落地与总结</Text>
    </Box>

    <Box style={{ height: '12px' }} />

    {/* B · 标题块 */}
    <Box style={{ height: '72px', justifyContent: 'center', gap: 4 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1A2230' }}>跑给你看：Web 端从发起到报告</Text>
        <Text style={{ fontSize: 16, color: '#4A5568' }}>演示模式（DR_DEMO=1）走真实 SSE 管线：事件流、进度、降级与生产是同一条代码路径，只是不调用真实模型</Text>
    </Box>

    <Box style={{ height: '12px' }} />

    {/* C · 内容区：左大图（报告完成态）+ 右栏（运行中 + 要点） */}
    <Box style={{ height: '484px', flexDirection: 'row', gap: 20 }}>

        {/* 左 · 报告完成态截图 */}
        <Box style={{ width: '696px', gap: 8 }}>
            <Image
                src='assets/ui-03-report.png'
                style={{ width: 696, height: 435, objectFit: 'cover', borderRadius: 8, border: '1px solid #D6DCE5' }}
            />
            <Text style={{ fontSize: 14, color: '#8B97A8' }}>
                报告完成态：引用校验 2/2 严格通过 · 完成节点 11 · Token 24,816 · 报告 729 字 · 成本估算 ¥0.30
            </Text>
        </Box>

        {/* 右 · 运行中截图 + 要点 */}
        <Box style={{ width: '484px', gap: 8 }}>
            <Image
                src='assets/ui-02-running.png'
                style={{ width: 484, height: 272, objectFit: 'cover', borderRadius: 8, border: '1px solid #D6DCE5' }}
            />
            <Text style={{ fontSize: 14, color: '#8B97A8' }}>
                运行中：检索阶段 30%，depth=2、裁决=continue，Token 实时累计
            </Text>

            <Box style={{ marginTop: 6, gap: 8 }}>
                <Box style={{ flexDirection: 'row', gap: 10, alignItems: 'flex-start' }}>
                    <Box style={{ width: '6px', height: '6px', borderRadius: 3, background: '#1E4FA8', marginTop: 8 }} />
                    <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.5, flex: 1 }}>SSE 实时事件：阶段进度、活动流、降级与恢复同屏可见，随时可协作式取消</Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 10, alignItems: 'flex-start' }}>
                    <Box style={{ width: '6px', height: '6px', borderRadius: 3, background: '#1E4FA8', marginTop: 8 }} />
                    <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.5, flex: 1 }}>运行摘要六项：总耗时 / 完成节点 / 检索跳数 / 降级条目 / 报告字数 / 成本估算</Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 10, alignItems: 'flex-start' }}>
                    <Box style={{ width: '6px', height: '6px', borderRadius: 3, background: '#1E4FA8', marginTop: 8 }} />
                    <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.5, flex: 1 }}>报告可导出 .md，文件名 = 主题名，正文带 run_id 与引用清单</Text>
                </Box>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: '12px' }} />

    {/* D · 页脚 */}
    <Box style={{ height: '32px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>DeepResearch 项目汇报 · 2026-10</Text>
