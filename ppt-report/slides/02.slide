<Slide style={{ width: '1280px', height: '720px', padding: '24px 40px', background: '#FFFFFF', justifyContent: 'flex-start' }}>

    {/* A · 页眉顶条 */}
    <Box style={{ height: '48px', background: '#0E3F8C', borderRadius: 6, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 24px' }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 'bold' }}>DeepResearch · 深度研究 Agent</Text>
        <Text style={{ fontSize: 16, color: '#FFFFFF', opacity: 0.85 }}>汇报目录</Text>
    </Box>

    <Box style={{ height: '12px' }} />

    {/* B · 标题块 */}
    <Box style={{ height: '72px', justifyContent: 'center', gap: 4 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1A2230' }}>汇报目录</Text>
        <Text style={{ fontSize: 16, color: '#4A5568' }}>五个问题，逐个回答：动机 → 架构 → 防幻觉 → 评测 → 落地</Text>
    </Box>

    <Box style={{ height: '12px' }} />

    {/* C · 内容区（左标题 + 右内容，非对称 28:72） */}
    <Box style={{ height: '484px', flexDirection: 'row', gap: 20 }}>

        {/* 左栏 · 导读 */}
        <Box style={{ width: '340px', height: '484px', background: '#E8EFF8', borderRadius: 8, padding: '28px 26px', gap: 14 }}>
            <Box style={{ width: '4px', height: '36px', background: '#0E3F8C' }} />
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C' }}>这一份汇报想说清什么</Text>
            <Text style={{ fontSize: 18, color: '#1A2230', lineHeight: 1.6 }}>
                不讲概念普及，只讲三件事：决策逻辑是怎么被建模的、效果是怎么被测出来的、以及哪些结论我们暂时还不能下。
            </Text>
            <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.6 }}>
                全篇数字均来自真实跑批与 CI 记录，不可判定的结论原样标注为「不可判定」。
            </Text>
            <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.6 }}>
                界面截图均来自本地实跑的演示模式（与生产共用同一条管线，只是不调用真实模型）。
            </Text>
            <Box style={{ marginTop: 'auto', gap: 10 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 10 }}>
                    <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#0E3F8C' }}>05</Text>
                    <Text style={{ fontSize: 16, color: '#4A5568' }}>个章节</Text>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 10 }}>
                    <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#0E3F8C' }}>23</Text>
                    <Text style={{ fontSize: 16, color: '#4A5568' }}>页 · 约 15 分钟</Text>
                </Box>
            </Box>
        </Box>

        {/* 右栏 · 5 条目录 */}
        <Box style={{ width: '820px', height: '484px', gap: 12 }}>
            <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 18, padding: '0 22px', background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 8 }}>
                <Box style={{ width: '44px', height: '44px', background: '#0E3F8C', borderRadius: 8, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>01</Text>
                </Box>
                <Box style={{ gap: 3 }}>
                    <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#1A2230' }}>项目背景与目标</Text>
                    <Text style={{ fontSize: 15, color: '#4A5568' }}>单次问答为什么做不了研究，以及本项目的三个设计应答（p04–05）</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 18, padding: '0 22px', background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 8 }}>
                <Box style={{ width: '44px', height: '44px', background: '#0E3F8C', borderRadius: 8, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>02</Text>
                </Box>
                <Box style={{ gap: 3 }}>
                    <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#1A2230' }}>系统架构与核心设计</Text>
                    <Text style={{ fontSize: 15, color: '#4A5568' }}>8 节点状态机、critic 条件边与硬闸、三路检索融合（p07–09）</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 18, padding: '0 22px', background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 8 }}>
                <Box style={{ width: '44px', height: '44px', background: '#0E3F8C', borderRadius: 8, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>03</Text>
                </Box>
                <Box style={{ gap: 3 }}>
                    <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#1A2230' }}>防幻觉与证据链</Text>
                    <Text style={{ fontSize: 15, color: '#4A5568' }}>图内校验、引用溯源四桶、从「有引用」走到「可回溯」（p11–12）</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 18, padding: '0 22px', background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 8 }}>
                <Box style={{ width: '44px', height: '44px', background: '#0E3F8C', borderRadius: 8, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>04</Text>
                </Box>
                <Box style={{ gap: 3 }}>
                    <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#1A2230' }}>评测方法与实验结果</Text>
                    <Text style={{ fontSize: 15, color: '#4A5568' }}>两阶段管道、四指标对照，以及为什么不宣称质量提升（p14–16）</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 18, padding: '0 22px', background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 8 }}>
                <Box style={{ width: '44px', height: '44px', background: '#0E3F8C', borderRadius: 8, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>05</Text>
                </Box>
                <Box style={{ gap: 3 }}>
                    <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#1A2230' }}>工程落地与总结</Text>
                    <Text style={{ fontSize: 15, color: '#4A5568' }}>从 CLI 脚本到可部署服务，以及仍然没做完的部分（p18–22）</Text>
                </Box>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: '12px' }} />

    {/* D · 页脚 */}
    <Box style={{ height: '32px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>DeepResearch 项目汇报 · 2026-10</Text>
        <Text style={{ fontSize: 14, color: '#1E4FA8' }}>02 / 23</Text>
    </Box>
</Slide>
