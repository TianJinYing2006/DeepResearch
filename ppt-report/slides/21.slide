<Slide style={{ width: '1280px', height: '720px', padding: '24px 40px', background: '#FFFFFF' }}>

    {/* A · 页眉顶条 */}
    <Box style={{ height: '48px', background: '#0E3F8C', borderRadius: 6, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 24px' }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 'bold' }}>DeepResearch · 深度研究 Agent</Text>
        <Text style={{ fontSize: 16, color: '#FFFFFF', opacity: 0.85 }}>05 工程落地与总结</Text>
    </Box>

    <Box style={{ height: '12px' }} />

    {/* B · 标题块 */}
    <Box style={{ height: '72px', justifyContent: 'center', gap: 4 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1A2230' }}>全链路可观测：一次真实运行的 trace</Text>
        <Text style={{ fontSize: 16, color: '#4A5568' }}>真实 CLI 运行（非演示模式）：主题「什么是 RAG?」，OpenTelemetry OTLP 导出至 Jaeger</Text>
    </Box>

    <Box style={{ height: '12px' }} />

    {/* C · 内容区：左大图（Jaeger trace）+ 右栏注解 */}
    <Box style={{ height: '484px', flexDirection: 'row', gap: 20 }}>

        {/* 左 · trace 截图 */}
        <Box style={{ width: '756px', gap: 8 }}>
            <Image
                src='assets/trace-jaeger.png'
                style={{ width: 756, height: 472, objectFit: 'cover', borderRadius: 8, border: '1px solid #D6DCE5' }}
            />
        </Box>

        {/* 右 · 注解 */}
        <Box style={{ width: '424px', gap: 12 }}>
            <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 10 }}>
                <Text style={{ fontSize: 72, fontWeight: 'bold', color: '#0E3F8C', lineHeight: 1.0 }}>86</Text>
                <Text style={{ fontSize: 18, color: '#4A5568' }}>个 span / 全程 15m29s</Text>
            </Box>

            <Box style={{ height: '1px', background: '#D6DCE5' }} />

            <Box style={{ gap: 10 }}>
                <Box style={{ flexDirection: 'row', gap: 10, alignItems: 'flex-start' }}>
                    <Box style={{ width: '6px', height: '6px', borderRadius: 3, background: '#1E4FA8', marginTop: 8 }} />
                    <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.5, flex: 1 }}>R1–R6 逐跳展开：每一跳「检索 → 修订」清晰可见，图上的回环结构在 trace 里复现</Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 10, alignItems: 'flex-start' }}>
                    <Box style={{ width: '6px', height: '6px', borderRadius: 3, background: '#1E4FA8', marginTop: 8 }} />
                    <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.5, flex: 1 }}>每次 LLM 调用是一个 generation 子 span，模型（qwen-plus）与耗时逐条可查</Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 10, alignItems: 'flex-start' }}>
                    <Box style={{ width: '6px', height: '6px', borderRadius: 3, background: '#1E4FA8', marginTop: 8 }} />
                    <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.5, flex: 1 }}>写作节点 4m52s，是全链最长段——这也是单轮成本优化的下一个靶点</Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 10, alignItems: 'flex-start' }}>
                    <Box style={{ width: '6px', height: '6px', borderRadius: 3, background: '#1E4FA8', marginTop: 8 }} />
                    <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.5, flex: 1 }}>CLI 运行结束回显 trace URL；后端可插拔：Jaeger / 自托管 Langfuse 均可</Text>
                </Box>
            </Box>

            <Box style={{ marginTop: 'auto', background: '#F0F5FC', borderRadius: 8, padding: '12px 16px' }}>
                <Text style={{ fontSize: 15, color: '#1A2230', lineHeight: 1.5 }}>
                    可观测不是「加了日志」，而是<span style={{ fontWeight: 'bold', color: '#0E3F8C' }}>每一次决策都能按时间轴回放</span>。
                </Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: '12px' }} />

    {/* D · 页脚 */}
    <Box style={{ height: '32px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>DeepResearch 项目汇报 · 2026-10</Text>
        <Text style={{ fontSize: 14, color: '#1E4FA8' }}>21 / 23</Text>
    </Box>
</Slide>
