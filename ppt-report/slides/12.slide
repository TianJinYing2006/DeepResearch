<Slide style={{ width: '1280px', height: '720px', padding: '24px 40px', background: '#FFFFFF' }}>

    {/* A · 页眉顶条 */}
    <Box style={{ height: '48px', background: '#0E3F8C', borderRadius: 6, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 24px' }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 'bold' }}>DeepResearch · 深度研究 Agent</Text>
        <Text style={{ fontSize: 16, color: '#FFFFFF', opacity: 0.85 }}>03 防幻觉与证据链</Text>
    </Box>

    <Box style={{ height: '12px' }} />

    {/* B · 标题块 */}
    <Box style={{ height: '72px', justifyContent: 'center', gap: 4 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1A2230' }}>从「有引用」到「可回溯」</Text>
        <Text style={{ fontSize: 16, color: '#4A5568' }}>引用不再是一串 URL，而是原文里的一段可复算坐标</Text>
    </Box>

    <Box style={{ height: '12px' }} />

    {/* C · 内容区：左大图 56% + 右侧文字 */}
    <Box style={{ height: '484px', flexDirection: 'row', gap: 20 }}>

        {/* 左 · L1 证据链 */}
        <Box style={{ width: '672px', background: '#F7F9FC', borderRadius: 8, alignItems: 'center', justifyContent: 'center' }}>
            <svg width={640} height={456} viewBox='0 0 640 456'>
                {/* 连接箭头 */}
                <path d='M330 86 L330 118' fill='none' stroke='#3D7BD9' strokeWidth='2' />
                <path d='M330 194 L330 226' fill='none' stroke='#3D7BD9' strokeWidth='2' />
                <path d='M330 302 L330 334' fill='none' stroke='#3D7BD9' strokeWidth='2' />

                {/* 步骤 1 */}
                <circle cx='52' cy='48' r='26' fill='#0E3F8C' />
                <text x='52' y='56' fontSize='18' fill='#FFFFFF' textAnchor='middle' fontWeight='bold'>1</text>
                <rect x='100' y='10' width='470' height='76' rx='8' fill='#FFFFFF' stroke='#3D7BD9' strokeWidth='2' />
                <text x='120' y='38' fontSize='16' fill='#1A2230' fontWeight='bold'>网页正文落盘为内容寻址快照</text>
                <text x='120' y='62' fontSize='13' fill='#4A5568'>robots 遵守 + 预算三闸（15 次 / 5 MB / 90 s），失败降级不阻塞主流程</text>
                <text x='120' y='80' fontSize='13' fill='#4A5568'>快照按内容哈希寻址，同一份材料只存一次</text>

                {/* 步骤 2 */}
                <circle cx='52' cy='156' r='26' fill='#0E3F8C' />
                <text x='52' y='164' fontSize='18' fill='#FFFFFF' textAnchor='middle' fontWeight='bold'>2</text>
                <rect x='100' y='118' width='470' height='76' rx='8' fill='#FFFFFF' stroke='#3D7BD9' strokeWidth='2' />
                <text x='120' y='146' fontSize='16' fill='#1A2230' fontWeight='bold'>引用携带逐字引文与字符偏移</text>
                <text x='120' y='170' fontSize='13' fill='#4A5568'>quote + char_start / char_end + snapshot_id + match_level</text>
                <text x='120' y='188' fontSize='13' fill='#4A5568'>定位分三级 L0 → L1 → L2，中文 2-gram 滑窗打分消歧</text>

                {/* 步骤 3 */}
                <circle cx='52' cy='264' r='26' fill='#1E4FA8' />
                <text x='52' y='272' fontSize='18' fill='#FFFFFF' textAnchor='middle' fontWeight='bold'>3</text>
                <rect x='100' y='226' width='470' height='76' rx='8' fill='#FFFFFF' stroke='#3D7BD9' strokeWidth='2' />
                <text x='120' y='254' fontSize='16' fill='#1A2230' fontWeight='bold'>交付自检（零模型，三项）</text>
                <text x='120' y='278' fontSize='13' fill='#4A5568'>引文是否可定位 / 是否落在被删或降格段落 / 版本句是否带引用</text>
                <text x='120' y='296' fontSize='13' fill='#4A5568'>不调用 LLM，用偏移切片复核 —— 结论可离线复算</text>

                {/* 步骤 4 */}
                <circle cx='52' cy='372' r='26' fill='#D9534F' />
                <text x='52' y='380' fontSize='18' fill='#FFFFFF' textAnchor='middle' fontWeight='bold'>4</text>
                <rect x='100' y='334' width='470' height='76' rx='8' fill='#FFFFFF' stroke='#D9534F' strokeWidth='2' />
                <text x='120' y='362' fontSize='16' fill='#1A2230' fontWeight='bold'>分级处置：致命 / 可修，只标注不删除</text>
                <text x='120' y='386' fontSize='13' fill='#4A5568'>未知来源 ID 判致命并阻断；快照缺失、引文过期、裸 URL 判可修</text>
                <text x='120' y='404' fontSize='13' fill='#4A5568'>红线：UNKNOWN / 缺失 / 过期一律不判为「事实错误」</text>

                <text x='330' y='440' fontSize='12' fill='#8B97A8' textAnchor='middle'>整条链路不新增模型的自由裁量权 —— 每一步都能离线复算</text>
            </svg>
        </Box>

        {/* 右 · 论述 */}
        <Box style={{ width: '508px', gap: 14 }}>
            <Box style={{ gap: 6 }}>
                <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#0E3F8C' }}>原来的问题</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.55 }}>
                    早期版本每条引用只有标题和 URL。想验证「这句话是否真的出自该网页」，只能人肉打开对照——引用是装饰，不是证据。
                </Text>
            </Box>

            <Box style={{ height: '1px', background: '#D6DCE5' }} />

            <Box style={{ gap: 6 }}>
                <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#0E3F8C' }}>现在的形态</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.55 }}>
                    引用 = 快照 ID + 逐字引文 + 原文字符偏移 + 匹配等级。<span style={{ fontWeight: 'bold' }}>任一读者都能按坐标回到原文复核</span>，不需要重新跑一遍模型。
                </Text>
            </Box>

            <Box style={{ height: '1px', background: '#D6DCE5' }} />

            <Box style={{ gap: 6 }}>
                <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#0E3F8C' }}>自检为什么要零模型</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.55 }}>
                    用模型检查模型，等于把不可靠性又绕回来。三项自检全部是确定性字符串与偏移运算，随时可重跑、结果必然一致。
                </Text>
            </Box>

            <Box style={{ marginTop: 'auto', background: '#F0F5FC', borderRadius: 8, padding: '14px 18px' }}>
                <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.5 }}>
                    这一步的意义不在指标好看，而在：<span style={{ fontWeight: 'bold', color: '#0E3F8C' }}>报告的每一句话都有了可追责的出处</span>。
                </Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: '12px' }} />

    {/* D · 页脚 */}
    <Box style={{ height: '32px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>DeepResearch 项目汇报 · 2026-10</Text>
        <Text style={{ fontSize: 14, color: '#1E4FA8' }}>12 / 23</Text>
    </Box>
</Slide>
