        <Text style={{ fontSize: 14, color: '#FFFFFF', opacity: 0.6, letterSpacing: 3 }}>CHAPTER 04</Text>
    </Box>

    <Box style={{ width: '500px', height: '720px', justifyContent: 'center', gap: 18, paddingRight: 40 }}>
