        <Text style={{ fontSize: 12, color: '#FFFFFF', opacity: 0.6 }}>真实运行 trace：86 spans / 15m29s，R1–R6 逐跳</Text>
        <Box style={{ flexDirection: 'row', gap: 8 }}>
