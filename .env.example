# ===== DeepResearch 环境变量模板 =====
# 复制为 .env 并填入真实值

# 阿里云百炼（LLM + Embedding）
DASHSCOPE_API_KEY=<your-dashscope-key>
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 博查搜索（网络搜索）
BOCHA_API_KEY=<your-bocha-key>
# 搜索 Provider（config.py 可配，默认 bocha；未来可扩展 tavily 等）
SEARCH_PROVIDER=bocha

# Qdrant（向量库，默认本地 6333 端口）
QDRANT_URL=http://127.0.0.1:6333

# ===== Langfuse 可观测（W3，设计评审 Q4/Q7 定稿）=====
# 三态开关：三件套（PUBLIC_KEY/SECRET_KEY/HOST）齐备即自动启用观测；
# 设 LANGFUSE_ENABLED=false 可强制禁用（CI/单测由 tests/conftest.py 强制关闭，零外发）。
# 启用后 CLI/Web 启动会打印知情行；敏感替换默认关闭。
LANGFUSE_PUBLIC_KEY=<your-langfuse-public-key>
LANGFUSE_SECRET_KEY=<your-langfuse-secret-key>
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=auto
# 开源逃生门：若观测事件超限，设 <1.0 采样（如 0.1）；默认 1.0 全采
LANGFUSE_SAMPLE_RATE=1.0
# 敏感替换（默认 false：不替换，避免误伤论文/代码中的数字信息）
LANGFUSE_MASK_SENSITIVE=false

# ===== W4 工具 + 强推理（设计评审 Q2/Q3/Q7 定稿）=====
# 模型分档：不设则回落 STRATEGIC_MODEL；默认 qwen-plus（保 W3 实测基线；演示可切 PLANNER_MODEL=... qwen-max）
# PLANNER_MODEL=qwen-max       # 规划 1 次/run，演示可用 qwen-max
# CRITIC_MODEL=qwen-plus       # 裁决多轮默认中等；演示强推理可切 deepseek-r1（注意 +10~30s/轮延迟）
# STRATEGIC_MODEL=qwen-plus    # 单档兼容别名（planner/critic 各自的回落值）

# 代码执行 sandbox（Q2）：可选 Windows Job Object 增强（默认关；开源前必须验证，DoD §7）
# CODE_EXEC_USE_JOB=false

# Semantic Scholar 后处理管道（Q3，可选）：无 key 则整条静默跳过；论文引用数"只采不决策"
# SEMANTIC_SCHOLAR_API_KEY=<your-semantic-scholar-key>
